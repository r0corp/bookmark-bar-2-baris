{
  "manifest_version": 3,
  "name": "Bookmark Bar 2 Baris",
  "short_name": "Bar 2 Baris",
  "version": "1.1.0",
  "description": "Bookmark bar Chrome 2 baris: status online server, pencarian cepat, profil Kerja/Pribadi. Lokal, tanpa koneksi internet.",
  "minimum_chrome_version": "116",
  "permissions": ["bookmarks", "storage", "favicon", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["_favicon/*"], "matches": ["<all_urls>"] }
  ],
  "action": { "default_title": "Tampilkan / sembunyikan bar (Alt+Shift+B)" },
  "commands": {
    "toggle-bar": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Tampilkan / sembunyikan bar"
    },
    "search": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Cari bookmark"
    },
    "profile": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Ganti profil Kerja / Pribadi"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
